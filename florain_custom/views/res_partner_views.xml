<odoo>
    <record id="main_members_view" model="ir.ui.view">
        
        <field name="name">Main Members View</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="replace" />
            <xpath expr="//field[@name='vat']" position="after">
            <group>
                <field name="ref" placeholder="0000" string="Subcription number" />
                <field name="membership_state" string="Subscription status" />
                <field name="orga_choice" placeholder="Le Florain" invisible="is_company==True" />
                <field name="account_cyclos" string="Account Cyclos"/>
                <field name="accept_newsletter" invisible="is_company==True" />
                <field name="changeeuros" placeholder="20.00" invisible="is_company==True" />
                <field name="prvlt_sepa"/>
            </group>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="commercial_name" invisible = "is_company == False" />
                <field name="is_organization" invisible = "is_company == False" />
                <field name="contact_email" invisible = "is_company == False" />
            </xpath>
        </field>
        
    </record>
</odoo>